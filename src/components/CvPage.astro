---
import SiteLayout from '../layouts/SiteLayout.astro';
import ExternalLinkIcon from './ExternalLinkIcon.astro';
import { copy, pathFor, type Language } from '../i18n';
const { lang } = Astro.props as { lang: Language };
const t = copy[lang];
---
<SiteLayout lang={lang} page="cv" title={t.cvTitle} description={t.cvDescription}>
  <div class="page-content">
    <section class="cv" id="cv" aria-labelledby="cv-title">
      <h1 id="cv-title">{t.cvHeading}<span class="period">.</span></h1>
      <div class="section-heading"><h2 id="work-title">{t.workTitle}</h2><p>{t.workIntro}</p></div>
      <div class="work-list">
        {t.projects.map((project) => <article class="work-item">
          <div class="work-meta"><span>{project.company}</span><span>{project.category}</span></div>
          <div class="work-description"><h3>{project.title}</h3><p>{project.description}</p>{'link' in project && <a class="text-link" href="https://diagramik.com" target="_blank" rel="noopener noreferrer">{project.link} <ExternalLinkIcon /></a>}</div>
        </article>)}
      </div>
      <a class="back-link" href={pathFor(lang, 'home')}>{t.backHome}</a>
    </section>
    <footer>© {new Date().getFullYear()} Krzysztof Watras</footer>
  </div>
</SiteLayout>

<style>
  .page-content { max-width: 1260px; margin: auto; padding: 0 clamp(1.5rem, 6.4vw, 7rem); }
  .cv { padding: 4.5rem 0 5.5rem; scroll-margin-top: 5rem; }
  h1 { margin: 0; font-size: clamp(3.35rem, 6.9vw, 6rem); font-weight: 600; line-height: 1.03; letter-spacing: -.038em; }
  .period { color: #a63843; }
  h2 { margin: 0; font-size: clamp(2.3rem, 3.6vw, 3.45rem); letter-spacing: -.035em; font-weight: 600; line-height: 1.12; }
  .section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 2rem; margin: 4rem 0 3rem; }
  .section-heading p { max-width: 200px; margin: 0; color: #826f62; font-size: .9rem; line-height: 1.5; }
  .work-item { display: grid; grid-template-columns: minmax(145px, .7fr) minmax(0, 2fr); gap: 2.5rem; padding: 2rem 0 2.3rem; border-top: 1px solid #e6ddd1; }
  .work-meta { display: flex; flex-direction: column; gap: .55rem; font: .7rem 'JetBrains Mono', monospace; line-height: 1.5; color: #816a51; }
  .work-meta span:first-child { color: #8d2934; font-weight: 700; }
  .work-description h3 { margin: 0; font-size: clamp(1.4rem, 2vw, 1.8rem); font-weight: 600; letter-spacing: -.025em; line-height: 1.2; }
  .work-description p { max-width: 62ch; margin: .85rem 0 0; font-size: .99rem; color: #5d5350; line-height: 1.7; }
  .text-link { display: inline-flex; align-items: center; gap: .35rem; margin-top: 1.1rem; color: #8d2934; font-weight: 600; text-decoration-thickness: 1px; }
  .back-link { display: inline-flex; align-items: center; min-height: 48px; margin-top: 3rem; color: #8d2934; font-weight: 600; text-decoration-thickness: 1px; }
  footer { padding: 1.3rem 0 2rem; border-top: 1px solid #e6ddd1; color: #887a70; font: .7rem 'JetBrains Mono', monospace; }
  @media (max-width: 1050px) { .page-content { padding-inline: clamp(2rem, 5vw, 4rem); } .section-heading { display: block; } .section-heading p { max-width: none; margin-top: .8rem; } }
  @media (max-width: 760px) { .page-content { padding: 0 1.5rem; } .cv { padding: 3.5rem 0 4rem; } .section-heading { margin: 3rem 0 2rem; } .work-item { grid-template-columns: 1fr; gap: .9rem; padding: 1.7rem 0 2rem; } .work-meta { flex-direction: row; justify-content: space-between; } }
</style>
