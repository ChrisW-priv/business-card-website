---
import SiteLayout from '../layouts/SiteLayout.astro';
import { copy, pathFor, type Language } from '../i18n';
const { lang } = Astro.props as { lang: Language };
const t = copy[lang];
---
<SiteLayout lang={lang} page="blog" title={t.blogTitle} description={t.blogDescription}>
  <div class="blog-page">
    <h1>{t.blogHeading}</h1>
    <p>{t.blogBody}</p>
    <a href={pathFor(lang, 'home')}>{t.backHome}</a>
  </div>
</SiteLayout>
<style>
  .blog-page { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; min-height: calc(100dvh - 64px); max-width: 860px; padding: 5rem clamp(1.5rem, 6.4vw, 7rem); }
  h1 { margin: 0; max-width: 13ch; font-size: clamp(2.9rem, 6vw, 5.5rem); font-weight: 600; letter-spacing: -.038em; line-height: 1.07; text-wrap: balance; }
  p { max-width: 55ch; margin: 1.75rem 0 2rem; color: #5d5350; font-size: clamp(1.1rem, 2vw, 1.4rem); line-height: 1.55; }
  a { display: inline-flex; align-items: center; min-height: 48px; color: #8d2934; font-weight: 600; text-decoration-thickness: 1px; gap: .75rem; }
  @media (max-width: 760px) { .blog-page { min-height: 60vh; padding: 4rem 1.5rem 5rem; } }
</style>
