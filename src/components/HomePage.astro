---
import SiteLayout from '../layouts/SiteLayout.astro';
import ExternalLinkIcon from './ExternalLinkIcon.astro';
import { copy, type Language } from '../i18n';
const { lang } = Astro.props as { lang: Language };
const t = copy[lang];
---
<SiteLayout lang={lang} title={t.title} description={t.description}>
  <div class="page-content">
    <section class="intro" id="whoami" aria-labelledby="intro-title">
      <h1 id="intro-title">{t.greeting}<span class="period">.</span></h1>
      <p class="lead">{t.lead}</p>
      <p class="intro-body">{t.aboutBefore}<a href="https://diagramik.com" target="_blank" rel="noopener noreferrer">Diagramik <ExternalLinkIcon /></a>{t.aboutAfter}</p>
      <a class="primary-link" href="mailto:chris.watras@gmail.com">{t.sayHello} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" /></svg></a>
      <div class="intro-foot">{t.disciplines.map((discipline, index) => <><span>{discipline}</span>{index < t.disciplines.length - 1 && <i aria-hidden="true"></i>}</>)}</div>
    </section>

    <section class="work" id="work" aria-labelledby="work-title">
      <div class="section-heading"><h2 id="work-title">{t.workTitle}</h2><p>{t.workIntro}</p></div>
      <div class="work-list">
        {t.projects.map((project) => <article class="work-item">
          <div class="work-meta"><span>{project.company}</span><span>{project.category}</span></div>
          <div class="work-description"><h3>{project.title}</h3><p>{project.description}</p>{'link' in project && <a class="text-link" href="https://diagramik.com" target="_blank" rel="noopener noreferrer">{project.link} <ExternalLinkIcon /></a>}</div>
        </article>)}
      </div>
    </section>

    <section class="contact" id="contact" aria-labelledby="contact-title">
      <div><h2 id="contact-title">{t.contactTitle}</h2><p>{t.contactIntro}</p></div>
      <a href="mailto:chris.watras@gmail.com">chris.watras@gmail.com</a>
    </section>
    <footer>© {new Date().getFullYear()} Krzysztof Watras</footer>
  </div>
</SiteLayout>

<style>
  .page-content { max-width: 1260px; margin: auto; padding: 0 clamp(1.5rem, 6.4vw, 7rem); }
  .intro { min-height: min(760px, 94vh); min-height: min(760px, 94dvh); display: flex; flex-direction: column; justify-content: center; padding: 3.2rem 0 2.8rem; scroll-margin-top: 5rem; }
  h1 { margin: 0; max-width: 12ch; font-size: clamp(3.35rem, 6.9vw, 6rem); font-weight: 600; line-height: 1.03; letter-spacing: -.038em; text-wrap: balance; }
  .period { color: #a63843; }
  .lead { max-width: 700px; margin: 2rem 0 0; font-size: clamp(1.45rem, 2.45vw, 2.1rem); line-height: 1.32; letter-spacing: -.025em; color: #703239; }
  .intro-body { max-width: 640px; margin: 1.3rem 0 0; font-size: 1.05rem; line-height: 1.7; color: #5d5350; }
  .intro-body a { color: #8d2934; font-weight: 600; white-space: nowrap; }
  .intro-body a :global(.external-icon) { font-size: .75em; }
  .primary-link { align-self: flex-start; display: inline-flex; align-items: center; justify-content: space-between; gap: 2.5rem; min-width: 190px; margin-top: 2.2rem; padding: .93rem 1.15rem; background: #8d2934; border: 1px solid #8d2934; border-radius: 4px; color: white; font-weight: 600; text-decoration: none; transition: background .2s ease, transform .2s ease, box-shadow .2s ease; }
  .primary-link:hover { background: #70202a; transform: translateY(-2px); box-shadow: 0 7px 17px #51232a30; }
  .primary-link svg { width: 21px; height: 21px; }
  .intro-foot { display: flex; align-items: center; gap: .9rem; flex-wrap: wrap; margin-top: auto; padding-top: 3rem; color: #876e55; font: .7rem 'JetBrains Mono', monospace; text-transform: uppercase; letter-spacing: .07em; }
  .intro-foot i { width: 4px; height: 4px; border-radius: 50%; background: #b89355; }
  .work { border-top: 1px solid #e6ddd1; padding: 5.5rem 0 7rem; scroll-margin-top: 5rem; }
  .section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 2rem; margin-bottom: 3rem; }
  h2 { margin: 0; font-size: clamp(2.3rem, 3.6vw, 3.45rem); letter-spacing: -.035em; font-weight: 600; line-height: 1.12; }
  .section-heading p { max-width: 200px; margin: 0; color: #826f62; font-size: .9rem; line-height: 1.5; }
  .work-item { display: grid; grid-template-columns: minmax(145px, .7fr) minmax(0, 2fr); gap: 2.5rem; padding: 2rem 0 2.3rem; border-top: 1px solid #e6ddd1; }
  .work-meta { display: flex; flex-direction: column; gap: .55rem; font: .7rem 'JetBrains Mono', monospace; line-height: 1.5; color: #816a51; }
  .work-meta span:first-child { color: #8d2934; font-weight: 700; }
  .work-description h3 { margin: 0; font-size: clamp(1.4rem, 2vw, 1.8rem); font-weight: 600; letter-spacing: -.025em; line-height: 1.2; }
  .work-description p { max-width: 62ch; margin: .85rem 0 0; font-size: .99rem; color: #5d5350; line-height: 1.7; }
  .text-link { display: inline-flex; align-items: center; gap: .35rem; margin-top: 1.1rem; color: #8d2934; font-weight: 600; text-decoration-thickness: 1px; }
  .contact { display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; padding: 3.2rem 0 4rem; border-top: 2px solid #aa844e; scroll-margin-top: 5rem; }
  .contact h2 { color: #8d2934; }
  .contact p { margin: .9rem 0 0; color: #5d5350; }
  .contact a { padding-bottom: .2rem; color: #8d2934; font-size: clamp(1rem, 1.5vw, 1.28rem); font-weight: 600; overflow-wrap: anywhere; text-decoration-thickness: 1px; }
  footer { padding: 1.3rem 0 2rem; border-top: 1px solid #e6ddd1; color: #887a70; font: .7rem 'JetBrains Mono', monospace; }
  @media (max-width: 1050px) { .page-content { padding-inline: clamp(2rem, 5vw, 4rem); } .intro { min-height: 700px; } .section-heading { display: block; } .section-heading p { max-width: none; margin-top: .8rem; } }
  @media (max-width: 760px) { .page-content { padding: 0 1.5rem; } .intro { min-height: 0; padding: 4.2rem 0 3.4rem; } h1 { font-size: clamp(3.1rem, 11vw, 5rem); } .lead { margin-top: 1.8rem; } .intro-body { font-size: 1rem; } .intro-foot { padding-top: 4rem; } .work { padding: 3.5rem 0 4rem; } .section-heading { margin-bottom: 2rem; } .work-item { grid-template-columns: 1fr; gap: .9rem; padding: 1.7rem 0 2rem; } .work-meta { flex-direction: row; justify-content: space-between; } .contact { align-items: flex-start; flex-direction: column; gap: 2rem; padding: 2.8rem 0 3.5rem; } }
</style>
